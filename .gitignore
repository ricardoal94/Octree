# ============================================================
# .gitignore — Proyecto Octree / ModelNet40
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/

# ── Entornos virtuales ──────────────────────────────────────
venv/
env/
ENV/
.venv/
*.venv

# ── Jupyter / IPython ────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Dataset (NO redistribuir) ────────────────────────────────
Dataset/
data/

# ── Pesos y checkpoints de modelos (regenerables) ────────────
checkpoints/
*.pth
*.pt
*.joblib
*.pkl
*.h5

# ── Logs de entrenamiento pesados (mantener solo resumenes) ──
# NOTA: hay dos carpetas "logs/" distintas en el proyecto (ver README,
# seccion "Estructura del repositorio"), no es un error de duplicacion:
#   - fase1_modelnet40/logs/  -> particion_indices.npz (Fase 1, regenerable
#     de forma deterministica con seed=42; experiment_log.json SI se
#     versiona, es liviano y util para auditoria)
#   - logs/ (raiz)            -> hce_features_R{R}.npz, net5_historial_R{R}.csv
#     (Fase 3, pesados, regenerables reentrenando)
fase1_modelnet40/logs/particion_indices.npz
!fase1_modelnet40/logs/.gitkeep
logs/*.csv
logs/*.npz
logs/dense_tabla5_historial_*.json
!logs/.gitkeep

# ── Renders e imagenes generadas en preprocesamiento ─────────
renders/

# ── Resultados grandes (mantener JSON de resumen, excluir figuras auto-generadas si se desea) ──
# Descomentar si no se quiere versionar las figuras PNG/SVG generadas:
# resultados/*.png
# resultados/*.svg

# Diagnosticos densos del Objetivo 3 (no son evidencia experimental)
resultados/objetivo3/resumen_dense_tabla5_*.json
resultados/objetivo3/verificacion_dense_tabla5.json

# ── Credenciales y configuracion local ───────────────────────
.env
*.env.local
config_local.yaml
secrets.yaml
*.key
*.pem

# ── Archivos temporales del sistema ───────────────────────────
*.tmp
*.temp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Editores / IDEs ───────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Rutas locales especificas de la maquina de desarrollo ────
# (evitar hardcodear, pero por si quedan archivos de prueba)
/test_*.py
/tmp/
*.local

# ── Archivos de salida temporales de matplotlib/figuras sueltas
*.svg.tmp
